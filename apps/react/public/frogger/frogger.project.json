  "interactions": {
    "variables": [
      {
        "name": "px",
        "initial": 0
      },
      {
        "name": "py",
        "initial": 0
      },
      {
        "name": "dead",
        "initial": 0
      },
      {
        "name": "won",
        "initial": 0
      }
    ],
    "handlers": [
      {
        "id": "2c80126f-e9e6-4b76-bb22-fb322adea7ec",
        "event": "keydown",
        "key": "ArrowLeft",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "px - 40"
            },
            "if": "dead == 0 && won == 0 && px > -150"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "47783373-f7ef-4f2b-baa5-a3b90d22f7d1",
        "event": "keydown",
        "key": "ArrowRight",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "px + 40"
            },
            "if": "dead == 0 && won == 0 && px < 150"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "75e10dce-e0d4-4851-b335-842dcc68ba26",
        "event": "keydown",
        "key": "ArrowDown",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "py + 80"
            },
            "if": "dead == 0 && won == 0 && py < 0"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "9904a8e2-48cb-49eb-8e00-f548ef91418f",
        "event": "keydown",
        "key": "ArrowUp",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "py - 80"
            },
            "if": "dead == 0 && won == 0 && py > -320"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "won",
              "value": "1"
            },
            "if": "py == -320 && dead == 0"
          }
        ]
      },
      {
        "id": "b9ff2693-e74a-423c-aee6-62aa62f8fb80",
        "event": "keydown",
        "key": "r",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "won",
              "value": "0"
            }
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          },
          {
            "kind": "show",
            "args": {
              "targetId": "frog"
            }
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'Arrows to move · reach the top!'"
            }
          }
        ]
      },
      {
        "id": "c0d3d3ef-f7d0-4726-84f8-0f23d0dc4e1f",
        "event": "tick",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -80 && xOf('car1') < 185 + px + 30 && xOf('car1') + 60 > 185 + px"
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -160 && xOf('car2') < 185 + px + 30 && xOf('car2') + 60 > 185 + px"
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -240 && xOf('car3') < 185 + px + 30 && xOf('car3') + 60 > 185 + px"
          },
          {
            "kind": "hide",
            "args": {
              "targetId": "frog"
            },
            "if": "dead == 1"
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'SPLAT! Press R to retry'"
            },
            "if": "dead == 1"
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'YOU MADE IT! Press R to play again'"
            },
            "if": "won == 1"
          }
        ]
      }
    ]
  }
