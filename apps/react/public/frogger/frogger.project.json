  "interactions": {
    "variables": [
      {
        "name": "px",
        "initial": 0
      },
      {
        "name": "py",
        "initial": 0
      },
      {
        "name": "dead",
        "initial": 0
      },
      {
        "name": "won",
        "initial": 0
      }
    ],
    "handlers": [
      {
        "id": "45c4bc56-23a8-48e0-9c90-3a188ab1d311",
        "event": "keydown",
        "key": "ArrowLeft",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "px - 40"
            },
            "if": "dead == 0 && won == 0 && px > -150"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "b7916e3d-fbfa-4144-ab48-af34ce4f5c3f",
        "event": "keydown",
        "key": "ArrowRight",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "px + 40"
            },
            "if": "dead == 0 && won == 0 && px < 150"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "b0eb0f2e-0a29-4821-aaae-e257de3adf57",
        "event": "keydown",
        "key": "ArrowDown",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "py + 80"
            },
            "if": "dead == 0 && won == 0 && py < 0"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          }
        ]
      },
      {
        "id": "3de404ee-1dad-4baf-91ef-821eb65bdce1",
        "event": "keydown",
        "key": "ArrowUp",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "py - 80"
            },
            "if": "dead == 0 && won == 0 && py > -320"
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "won",
              "value": "1"
            },
            "if": "py == -320 && dead == 0"
          }
        ]
      },
      {
        "id": "e6ecf230-3ab5-4d8b-adec-9c9e56d7e8ce",
        "event": "keydown",
        "key": "r",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "px",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "py",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "0"
            }
          },
          {
            "kind": "setVar",
            "args": {
              "name": "won",
              "value": "0"
            }
          },
          {
            "kind": "setPosition",
            "args": {
              "targetId": "frog",
              "dx": "px",
              "dy": "py"
            }
          },
          {
            "kind": "show",
            "args": {
              "targetId": "frog"
            }
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'Arrows to move · reach the top!'"
            }
          }
        ]
      },
      {
        "id": "3d7bafca-2004-4e1c-b29e-5ea4297f6b68",
        "event": "tick",
        "actions": [
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -80 && -60 + 130 * time < 185 + px + 30 && -60 + 130 * time + 60 > 185 + px"
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -160 && 460 - 130 * time < 185 + px + 30 && 460 - 130 * time + 60 > 185 + px"
          },
          {
            "kind": "setVar",
            "args": {
              "name": "dead",
              "value": "1"
            },
            "if": "dead == 0 && won == 0 && py == -240 && -60 + 260 * time < 185 + px + 30 && -60 + 260 * time + 60 > 185 + px"
          },
          {
            "kind": "hide",
            "args": {
              "targetId": "frog"
            },
            "if": "dead == 1"
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'SPLAT! Press R to retry'"
            },
            "if": "dead == 1"
          },
          {
            "kind": "setText",
            "args": {
              "targetId": "status",
              "value": "'YOU MADE IT! Press R to play again'"
            },
            "if": "won == 1"
          }
        ]
      }
    ]
  }
}